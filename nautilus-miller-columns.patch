+/*
+ * Copyright (C) 2026 The GNOME project contributors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include "nautilus-types.h"
+
+#include <gtk/gtk.h>
+
+G_BEGIN_DECLS
+
+#define NAUTILUS_TYPE_COLUMN_MODEL (nautilus_column_model_get_type ())
+
+G_DECLARE_FINAL_TYPE (NautilusColumnModel, nautilus_column_model, NAUTILUS, COLUMN_MODEL, GObject)
+
+NautilusColumnModel *nautilus_column_model_new (NautilusViewModel *shared_model,
+                                                GtkTreeListRow    *parent_row);
+
+GtkTreeListRow *nautilus_column_model_get_parent_row (NautilusColumnModel *self);
+
+/* Position of @position in the shared model, or GTK_INVALID_LIST_POSITION. */
+guint nautilus_column_model_get_global_position (NautilusColumnModel *self,
+                                                 guint                position);
+
+/* Position of @row in this slice, or GTK_INVALID_LIST_POSITION if not here. */
+guint nautilus_column_model_find_row (NautilusColumnModel *self,
+                                      GtkTreeListRow      *row);
+
+/* The row whose child column is open; not part of the shared selection. */
+GtkTreeListRow *nautilus_column_model_get_path_row (NautilusColumnModel *self);
+void nautilus_column_model_set_path_row (NautilusColumnModel *self,
+                                         GtkTreeListRow      *row);
+
+G_END_DECLS
diff --git a/src/nautilus-columns-view.c b/src/nautilus-columns-view.c
new file mode 100644
index 000000000..04e4c3aff
--- /dev/null
+++ b/src/nautilus-columns-view.c
@@ -0,0 +1,975 @@
+/*
+ * Copyright (C) 2026 The GNOME project contributors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "nautilus-columns-view.h"
+
+#include "nautilus-column-model.h"
+#include "nautilus-file.h"
+#include "nautilus-global-preferences.h"
+#include "nautilus-list-base-private.h"
+#include "nautilus-name-cell.h"
+#include "nautilus-view-cell.h"
+#include "nautilus-view-item.h"
+#include "nautilus-view-model.h"
+
+#include <glib/gi18n.h>
+
+/**
+ * NautilusColumnsView:
+ *
+ * Miller columns: one #GtkListView per directory level. Like the list view's
+ * tree mode, it expands rows of the shared #NautilusViewModel; each column shows
+ * one level through a #NautilusColumnModel.
+ */
+
+/* ponytail: fixed column width; add a setting and drag handle if asked. */
+#define COLUMN_WIDTH 250
+
+typedef struct
+{
+    NautilusColumnsView *view;
+    GtkWidget *scrolled_window;
+    GtkWidget *list_view;
+    NautilusColumnModel *model;
+} Column;
+
+struct _NautilusColumnsView
+{
+    NautilusListBase parent_instance;
+
+    GtkWidget *columns_box;
+    GPtrArray *columns;
+
+    gint zoom_level;
+
+    gboolean directories_first;
+    gboolean expand_as_a_tree;
+    gboolean rubberband_enabled;
+
+    /* Collapsing rows makes the shared model emit right back. */
+    gboolean updating_columns;
+    gboolean scroll_to_end;
+    guint prune_columns_id;
+
+    NautilusViewModel *connected_model; /* Unowned */
+
+    GQuark sort_attribute;
+    gboolean reversed;
+    GtkSorter *view_model_sorter;
+};
+
+G_DEFINE_FINAL_TYPE (NautilusColumnsView, nautilus_columns_view, NAUTILUS_TYPE_LIST_BASE)
+
+enum
+{
+    LOAD_SUBDIRECTORY,
+    UNLOAD_SUBDIRECTORY,
+    DISPLAY_LOCATION_CHANGED,
+    LAST_SIGNAL
+};
+
+static guint signals[LAST_SIGNAL];
+
+static const NautilusViewInfo columns_view_info =
+{
+    .view_id = NAUTILUS_VIEW_COLUMNS_ID,
+    .zoom_level_min = NAUTILUS_LIST_ZOOM_LEVEL_SMALL,
+    .zoom_level_max = NAUTILUS_LIST_ZOOM_LEVEL_LARGE,
+    .zoom_level_standard = NAUTILUS_LIST_ZOOM_LEVEL_MEDIUM,
+};
+
+static inline Column *
+get_column (NautilusColumnsView *self,
+            guint                index)
+{
+    return g_ptr_array_index (self->columns, index);
+}
+
+static NautilusViewInfo
+real_get_view_info (NautilusListBase *list_base)
+{
+    return columns_view_info;
+}
+
+static guint
+get_icon_size_for_zoom_level (NautilusListZoomLevel zoom_level)
+{
+    switch (zoom_level)
+    {
+        case NAUTILUS_LIST_ZOOM_LEVEL_SMALL:
+        {
+            return NAUTILUS_LIST_ICON_SIZE_SMALL;
+        }
+        break;
+
+        case NAUTILUS_LIST_ZOOM_LEVEL_MEDIUM:
+        {
+            return NAUTILUS_LIST_ICON_SIZE_MEDIUM;
+        }
+        break;
+
+        case NAUTILUS_LIST_ZOOM_LEVEL_LARGE:
+        {
+            return NAUTILUS_LIST_ICON_SIZE_LARGE;
+        }
+        break;
+    }
+    g_return_val_if_reached (NAUTILUS_LIST_ICON_SIZE_MEDIUM);
+}
+
+static guint
+real_get_icon_size (NautilusListBase *list_base)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (list_base);
+
+    return get_icon_size_for_zoom_level (self->zoom_level);
+}
+
+static int
+real_get_zoom_level (NautilusListBase *list_base)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (list_base);
+
+    return self->zoom_level;
+}
+
+/* ponytail: zoom level shared with the list view; own schema if it annoys. */
+static gint
+get_default_zoom_level (void)
+{
+    gint default_zoom_level = g_settings_get_enum (nautilus_list_view_preferences,
+                                                   NAUTILUS_PREFERENCES_LIST_VIEW_DEFAULT_ZOOM_LEVEL);
+
+    return CLAMP (default_zoom_level,
+                  columns_view_info.zoom_level_min,
+                  columns_view_info.zoom_level_max);
+}
+
+static void
+real_set_zoom_level (NautilusListBase *list_base,
+                     int               new_level)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (list_base);
+
+    g_return_if_fail (new_level >= columns_view_info.zoom_level_min &&
+                      new_level <= columns_view_info.zoom_level_max);
+
+    self->zoom_level = new_level;
+
+    if (g_settings_get_enum (nautilus_list_view_preferences,
+                             NAUTILUS_PREFERENCES_LIST_VIEW_DEFAULT_ZOOM_LEVEL) != new_level)
+    {
+        g_settings_set_enum (nautilus_list_view_preferences,
+                             NAUTILUS_PREFERENCES_LIST_VIEW_DEFAULT_ZOOM_LEVEL,
+                             new_level);
+    }
+
+    g_object_notify (G_OBJECT (self), "icon-size");
+
+    if (self->zoom_level == NAUTILUS_LIST_ZOOM_LEVEL_SMALL)
+    {
+        gtk_widget_add_css_class (GTK_WIDGET (self), "compact");
+    }
+    else
+    {
+        gtk_widget_remove_css_class (GTK_WIDGET (self), "compact");
+    }
+}
+
+static gint
+nautilus_columns_view_sort (gconstpointer a,
+                            gconstpointer b,
+                            gpointer      user_data)
+{
+    NautilusColumnsView *self = user_data;
+    NautilusFile *file_a = nautilus_view_item_get_file ((NautilusViewItem *) a);
+    NautilusFile *file_b = nautilus_view_item_get_file ((NautilusViewItem *) b);
+
+    return nautilus_file_compare_for_sort_by_attribute_q (file_a, file_b,
+                                                          self->sort_attribute,
+                                                          self->directories_first,
+                                                          self->reversed);
+}
+
+static GVariant *
+real_get_sort_state (NautilusListBase *list_base)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (list_base);
+
+    return g_variant_take_ref (g_variant_new ("(sb)",
+                                              g_quark_to_string (self->sort_attribute),
+                                              self->reversed));
+}
+
+static void
+real_set_sort_state (NautilusListBase *list_base,
+                     GVariant         *value)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (list_base);
+    NautilusViewModel *model = nautilus_list_base_get_model (list_base);
+    const gchar *target_name;
+    g_autoptr (GtkCustomSorter) sorter = NULL;
+
+    /* Sort state binding should be set after the model is set. */
+    g_return_if_fail (model != NULL);
+
+    g_variant_get (value, "(&sb)", &target_name, &self->reversed);
+    self->sort_attribute = g_quark_from_string (target_name);
+
+    sorter = gtk_custom_sorter_new (nautilus_columns_view_sort, self, NULL);
+    g_set_object (&self->view_model_sorter, GTK_SORTER (sorter));
+    nautilus_view_model_set_sorter (model, GTK_SORTER (sorter));
+}
+
+static void
+real_set_enable_rubberband (NautilusListBase *list_base,
+                            gboolean          enabled)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (list_base);
+
+    self->rubberband_enabled = enabled;
+    for (guint i = 0; i < self->columns->len; i++)
+    {
+        gtk_list_view_set_enable_rubberband (GTK_LIST_VIEW (get_column (self, i)->list_view),
+                                             enabled);
+    }
+}
+
+static guint
+find_column_for_row (NautilusColumnsView *self,
+                     GtkTreeListRow      *row,
+                     guint               *out_position)
+{
+    for (guint i = 0; i < self->columns->len; i++)
+    {
+        guint position = nautilus_column_model_find_row (get_column (self, i)->model, row);
+
+        if (position != GTK_INVALID_LIST_POSITION)
+        {
+            if (out_position != NULL)
+            {
+                *out_position = position;
+            }
+            return i;
+        }
+    }
+
+    return G_MAXUINT;
+}
+
+static void
+real_scroll_to (NautilusListBase   *list_base,
+                guint               position,
+                GtkListScrollFlags  flags,
+                GtkScrollInfo      *scroll)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (list_base);
+    NautilusViewModel *model = nautilus_list_base_get_model (list_base);
+    g_autoptr (GtkTreeListRow) row = NULL;
+    guint column_position;
+    guint index;
+
+    if (model != NULL)
+    {
+        row = g_list_model_get_item (G_LIST_MODEL (model), position);
+    }
+
+    index = (row != NULL) ? find_column_for_row (self, row, &column_position) : G_MAXUINT;
+    if (index == G_MAXUINT)
+    {
+        g_clear_pointer (&scroll, gtk_scroll_info_unref);
+        return;
+    }
+
+    gtk_list_view_scroll_to (GTK_LIST_VIEW (get_column (self, index)->list_view),
+                             column_position, flags, scroll);
+}
+
+static NautilusViewItem *
+real_get_backing_item (NautilusListBase *list_base)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (list_base);
+    GtkTreeListRow *parent_row;
+
+    if (self->columns->len == 0)
+    {
+        return NULL;
+    }
+
+    /* Background operations target the rightmost column's directory. */
+    parent_row = nautilus_column_model_get_parent_row (get_column (self, self->columns->len - 1)->model);
+
+    return (parent_row != NULL) ? gtk_tree_list_row_get_item (parent_row) : NULL;
+}
+
+/* The rightmost column's folder, or NULL when that is the view's own. */
+static void
+emit_display_location_changed (NautilusColumnsView *self)
+{
+    g_autoptr (NautilusViewItem) item = real_get_backing_item (NAUTILUS_LIST_BASE (self));
+    g_autoptr (GFile) location = (item != NULL) ?
+                                 nautilus_file_get_location (nautilus_view_item_get_file (item)) :
+                                 NULL;
+
+    g_signal_emit (self, signals[DISPLAY_LOCATION_CHANGED], 0, location);
+}
+
+static void
+column_free (Column *column)
+{
+    /* The factory may outlive the list view, and its callbacks hold @column. */
+    g_signal_handlers_disconnect_by_data (gtk_list_view_get_factory (GTK_LIST_VIEW (column->list_view)),
+                                          column);
+    gtk_box_remove (GTK_BOX (column->view->columns_box), column->scrolled_window);
+
+    g_clear_object (&column->model);
+    g_free (column);
+}
+
+/* On the row widget, so it matches the selection highlight. */
+static void
+set_path_row_class (GtkWidget *cell,
+                    gboolean   is_path_row)
+{
+    if (is_path_row)
+    {
+        gtk_widget_add_css_class (gtk_widget_get_parent (cell), "path-row");
+    }
+    else
+    {
+        gtk_widget_remove_css_class (gtk_widget_get_parent (cell), "path-row");
+    }
+}
+
+/* GtkListView doesn't re-bind a row whose item is unchanged, so restyle the
+ * bound rows directly; rows bound later get it from bind_cell(). */
+static void
+set_path_row (Column         *column,
+              GtkTreeListRow *row)
+{
+    g_autoptr (NautilusViewItem) path_item = (row != NULL) ? gtk_tree_list_row_get_item (row) : NULL;
+
+    nautilus_column_model_set_path_row (column->model, row);
+
+    for (GtkWidget *child = gtk_widget_get_first_child (column->list_view);
+         child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkWidget *cell = gtk_widget_get_first_child (child);
+        g_autoptr (NautilusViewItem) item = NULL;
+
+        if (!NAUTILUS_IS_VIEW_CELL (cell))
+        {
+            continue;
+        }
+
+        item = nautilus_view_cell_get_item (NAUTILUS_VIEW_CELL (cell));
+        set_path_row_class (cell, item != NULL && item == path_item);
+    }
+}
+
+/* Drops every column from @n_keep onwards and unloads their directories. */
+static void
+truncate_columns (NautilusColumnsView *self,
+                  guint                n_keep)
+{
+    gboolean was_updating = self->updating_columns;
+
+    self->updating_columns = TRUE;
+
+    while (self->columns->len > n_keep)
+    {
+        Column *column = get_column (self, self->columns->len - 1);
+        GtkTreeListRow *parent_row = nautilus_column_model_get_parent_row (column->model);
+
+        if (parent_row != NULL)
+        {
+            g_autoptr (NautilusViewItem) item = gtk_tree_list_row_get_item (parent_row);
+
+            /* Collapse first, so the tree model releases the child store. */
+            gtk_tree_list_row_set_expanded (parent_row, FALSE);
+
+            if (item != NULL)
+            {
+                g_signal_emit (self, signals[UNLOAD_SUBDIRECTORY], 0, item);
+            }
+        }
+
+        g_ptr_array_remove_index (self->columns, self->columns->len - 1);
+    }
+
+    if (self->columns->len > 0)
+    {
+        set_path_row (get_column (self, self->columns->len - 1), NULL);
+    }
+
+    self->scroll_to_end = FALSE;
+    emit_display_location_changed (self);
+
+    self->updating_columns = was_updating;
+}
+
+static void
+setup_cell (GtkSignalListItemFactory *factory,
+            GtkListItem              *listitem,
+            gpointer                  user_data)
+{
+    Column *column = user_data;
+    NautilusColumnsView *self = column->view;
+    NautilusViewCell *cell = nautilus_name_cell_new (NAUTILUS_LIST_BASE (self));
+    GtkExpression *expression;
+
+    gtk_list_item_set_child (listitem, GTK_WIDGET (cell));
+
+    setup_cell_common (G_OBJECT (listitem), cell,
+                       nautilus_name_cell_get_content (NAUTILUS_NAME_CELL (cell)));
+
+    nautilus_view_cell_set_slice_model (cell, column->model);
+
+    g_object_bind_property (self, "icon-size",
+                            cell, "icon-size",
+                            G_BINDING_SYNC_CREATE);
+
+    /* Use file display name as accessible label. Explaining in pseudo-code:
+     * listitem:accessible-name :- listitem:item:item:file:a11y-name */
+    expression = gtk_property_expression_new (GTK_TYPE_LIST_ITEM, NULL, "item");
+    expression = gtk_property_expression_new (GTK_TYPE_TREE_LIST_ROW, expression, "item");
+    expression = gtk_property_expression_new (NAUTILUS_TYPE_VIEW_ITEM, expression, "file");
+    expression = gtk_property_expression_new (NAUTILUS_TYPE_FILE, expression, "a11y-name");
+    gtk_expression_bind (expression, listitem, "accessible-label", listitem);
+}
+
+static void
+bind_cell (GtkSignalListItemFactory *factory,
+           GtkListItem              *listitem,
+           gpointer                  user_data)
+{
+    Column *column = user_data;
+    GtkWidget *cell = gtk_list_item_get_child (listitem);
+    GtkTreeListRow *row = GTK_TREE_LIST_ROW (gtk_list_item_get_item (listitem));
+    g_autoptr (NautilusViewItem) item = NAUTILUS_VIEW_ITEM (gtk_tree_list_row_get_item (row));
+
+    g_return_if_fail (item != NULL);
+
+    set_path_row_class (cell, row == nautilus_column_model_get_path_row (column->model));
+
+    nautilus_view_item_set_item_ui (item, cell);
+
+    gtk_tree_expander_set_list_row (nautilus_name_cell_get_expander (NAUTILUS_NAME_CELL (cell)),
+                                    NULL);
+}
+
+static void
+unbind_cell (GtkSignalListItemFactory *factory,
+             GtkListItem              *listitem,
+             gpointer                  user_data)
+{
+    gpointer row = gtk_list_item_get_item (listitem);
+    g_autoptr (NautilusViewItem) item = (row != NULL) ?
+                                       gtk_tree_list_row_get_item (GTK_TREE_LIST_ROW (row)) :
+                                       NULL;
+
+    /* item may be NULL when the row has just been destroyed. */
+    if (item != NULL)
+    {
+        nautilus_view_item_set_item_ui (item, NULL);
+    }
+}
+
+static void
+on_item_activated (GtkListView *list_view,
+                   guint        position,
+                   gpointer     user_data)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (user_data);
+
+    nautilus_list_base_activate_selection (NAUTILUS_LIST_BASE (self), FALSE);
+}
+
+static void
+append_column (NautilusColumnsView *self,
+               GtkTreeListRow      *parent_row)
+{
+    NautilusViewModel *model = nautilus_list_base_get_model (NAUTILUS_LIST_BASE (self));
+    Column *column;
+
+    g_return_if_fail (model != NULL);
+
+    column = g_new0 (Column, 1);
+    column->view = self;
+    column->model = nautilus_column_model_new (model, parent_row);
+
+    GtkListItemFactory *factory = gtk_signal_list_item_factory_new ();
+    g_signal_connect (factory, "setup", G_CALLBACK (setup_cell), column);
+    g_signal_connect (factory, "bind", G_CALLBACK (bind_cell), column);
+    g_signal_connect (factory, "unbind", G_CALLBACK (unbind_cell), column);
+
+    column->list_view = gtk_list_view_new (GTK_SELECTION_MODEL (g_object_ref (column->model)),
+                                           factory);
+
+    gtk_list_view_set_single_click_activate (GTK_LIST_VIEW (column->list_view), FALSE);
+    gtk_list_view_set_tab_behavior (GTK_LIST_VIEW (column->list_view), GTK_LIST_TAB_ITEM);
+    gtk_list_view_set_enable_rubberband (GTK_LIST_VIEW (column->list_view),
+                                         self->rubberband_enabled);
+    g_signal_connect (column->list_view, "activate", G_CALLBACK (on_item_activated), self);
+
+    column->scrolled_window = gtk_scrolled_window_new ();
+    gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (column->scrolled_window),
+                                    GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+    gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (column->scrolled_window),
+                                   column->list_view);
+    gtk_widget_set_size_request (column->scrolled_window, COLUMN_WIDTH, -1);
+    gtk_widget_set_vexpand (column->scrolled_window, TRUE);
+
+    gtk_box_append (GTK_BOX (self->columns_box), column->scrolled_window);
+    g_ptr_array_add (self->columns, column);
+
+    self->scroll_to_end = TRUE;
+    emit_display_location_changed (self);
+}
+
+static void
+update_columns_for_selection (NautilusColumnsView *self)
+{
+    NautilusViewModel *model = nautilus_list_base_get_model (NAUTILUS_LIST_BASE (self));
+    g_autoptr (GtkBitset) selection = NULL;
+    g_autoptr (GtkTreeListRow) row = NULL;
+    g_autoptr (NautilusViewItem) item = NULL;
+    guint index;
+
+    if (model == NULL || self->updating_columns)
+    {
+        return;
+    }
+
+    selection = gtk_selection_model_get_selection (GTK_SELECTION_MODEL (model));
+    if (gtk_bitset_get_size (selection) != 1)
+    {
+        return;
+    }
+
+    row = g_list_model_get_item (G_LIST_MODEL (model), gtk_bitset_get_nth (selection, 0));
+
+    index = find_column_for_row (self, row, NULL);
+    if (index == G_MAXUINT)
+    {
+        return;
+    }
+
+    self->updating_columns = TRUE;
+
+    if (index + 1 < self->columns->len &&
+        nautilus_column_model_get_parent_row (get_column (self, index + 1)->model) == row)
+    {
+        /* Column already open; re-creating it would reload the directory. */
+        truncate_columns (self, index + 2);
+        set_path_row (get_column (self, index), row);
+    }
+    else
+    {
+        truncate_columns (self, index + 1);
+
+        item = gtk_tree_list_row_get_item (row);
+        if (self->expand_as_a_tree &&
+            item != NULL &&
+            nautilus_file_is_directory (nautilus_view_item_get_file (item)))
+        {
+            set_path_row (get_column (self, index), row);
+
+            if (!gtk_tree_list_row_get_expanded (row))
+            {
+                gtk_tree_list_row_set_expanded (row, TRUE);
+                g_signal_emit (self, signals[LOAD_SUBDIRECTORY], 0, item);
+            }
+
+            append_column (self, row);
+        }
+    }
+
+    self->updating_columns = FALSE;
+}
+
+/* Drops columns whose directory is gone, then re-syncs with the selection.
+ * Idle: the column models may not have rebuilt yet, and the shared model must
+ * not be mutated while it is emitting. */
+static void
+prune_columns (gpointer user_data)
+{
+    NautilusColumnsView *self = user_data;
+
+    self->prune_columns_id = 0;
+
+    for (guint i = 1; i < self->columns->len; i++)
+    {
+        GtkTreeListRow *parent_row = nautilus_column_model_get_parent_row (get_column (self, i)->model);
+
+        if (parent_row == NULL ||
+            nautilus_column_model_find_row (get_column (self, i - 1)->model,
+                                            parent_row) == GTK_INVALID_LIST_POSITION)
+        {
+            truncate_columns (self, i);
+            break;
+        }
+    }
+
+    update_columns_for_selection (self);
+}
+
+static void
+schedule_prune_columns (NautilusColumnsView *self)
+{
+    if (self->prune_columns_id == 0)
+    {
+        self->prune_columns_id = g_idle_add_once (prune_columns, self);
+    }
+}
+
+static void
+on_model_changed (NautilusColumnsView *self)
+{
+    NautilusViewModel *model = nautilus_list_base_get_model (NAUTILUS_LIST_BASE (self));
+
+    truncate_columns (self, 0);
+
+    /* Runs on every set, same model or not. */
+    if (self->connected_model != NULL)
+    {
+        g_signal_handlers_disconnect_by_data (self->connected_model, self);
+        self->connected_model = NULL;
+    }
+
+    if (model == NULL)
+    {
+        return;
+    }
+
+    nautilus_view_model_expand_as_a_tree (model, self->expand_as_a_tree);
+
+    g_signal_connect_object (model, "selection-changed",
+                             G_CALLBACK (schedule_prune_columns), self,
+                             G_CONNECT_SWAPPED);
+    g_signal_connect_object (model, "items-changed",
+                             G_CALLBACK (schedule_prune_columns), self,
+                             G_CONNECT_SWAPPED);
+    self->connected_model = model;
+
+    append_column (self, NULL);
+
+    /* Sync with a selection kept across a view switch, once
+     * NautilusFilesView has connected ::load-subdirectory. */
+    schedule_prune_columns (self);
+}
+
+static void
+update_sort_directories_first (NautilusColumnsView *self)
+{
+    NautilusFile *directory_as_file = nautilus_list_base_get_directory_as_file (NAUTILUS_LIST_BASE (self));
+    NautilusViewModel *model = nautilus_list_base_get_model (NAUTILUS_LIST_BASE (self));
+
+    /* Always treat directories as normal items in search and recent. Recent
+     * can accidentally contain directories when they were picked via file chooser. */
+    if (nautilus_file_is_in_search (directory_as_file) ||
+        nautilus_file_is_in_recent (directory_as_file))
+    {
+        self->directories_first = FALSE;
+    }
+    else
+    {
+        self->directories_first = g_settings_get_boolean (gtk_filechooser_preferences,
+                                                          NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST);
+    }
+
+    if (model != NULL)
+    {
+        nautilus_view_model_sort (model);
+    }
+}
+
+static void
+real_setup_directory (NautilusListBase  *list_base,
+                      NautilusDirectory *new_directory)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (list_base);
+    NautilusViewModel *model;
+    NautilusFile *file;
+
+    NAUTILUS_LIST_BASE_CLASS (nautilus_columns_view_parent_class)->setup_directory (list_base, new_directory);
+
+    file = nautilus_list_base_get_directory_as_file (list_base);
+
+    /* Same limit as the list view's tree mode: a single column where files
+     * may be listed outside their parent. */
+    self->expand_as_a_tree = !(nautilus_file_is_in_search (file) ||
+                               nautilus_file_is_in_recent (file) ||
+                               nautilus_file_is_in_starred (file) ||
+                               nautilus_file_is_in_trash (file));
+
+    update_sort_directories_first (self);
+
+    model = nautilus_list_base_get_model (list_base);
+    if (model != NULL)
+    {
+        nautilus_view_model_expand_as_a_tree (model, self->expand_as_a_tree);
+        truncate_columns (self, 1);
+    }
+}
+
+static guint
+find_focused_column (NautilusColumnsView *self)
+{
+    GtkRoot *root = gtk_widget_get_root (GTK_WIDGET (self));
+    GtkWidget *focus = (root != NULL) ? gtk_root_get_focus (root) : NULL;
+
+    if (focus == NULL)
+    {
+        return G_MAXUINT;
+    }
+
+    for (guint i = 0; i < self->columns->len; i++)
+    {
+        GtkWidget *list_view = get_column (self, i)->list_view;
+
+        if (focus == list_view || gtk_widget_is_ancestor (focus, list_view))
+        {
+            return i;
+        }
+    }
+
+    return G_MAXUINT;
+}
+
+static gboolean
+select_in_column (NautilusColumnsView *self,
+                  guint                index,
+                  guint                position)
+{
+    Column *column = get_column (self, index);
+
+    if (position >= g_list_model_get_n_items (G_LIST_MODEL (column->model)))
+    {
+        return FALSE;
+    }
+
+    gtk_widget_grab_focus (column->list_view);
+    gtk_list_view_scroll_to (GTK_LIST_VIEW (column->list_view), position,
+                             GTK_LIST_SCROLL_FOCUS | GTK_LIST_SCROLL_SELECT, NULL);
+
+    return TRUE;
+}
+
+/* Left and Right move between columns, the way Up and Down move within one. */
+static gboolean
+move_between_columns_cb (GtkWidget *widget,
+                         GVariant  *args,
+                         gpointer   user_data)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (widget);
+    gboolean forward = (GPOINTER_TO_INT (user_data) == GDK_KEY_Right);
+    guint index = find_focused_column (self);
+
+    if (gtk_widget_get_direction (widget) == GTK_TEXT_DIR_RTL)
+    {
+        forward = !forward;
+    }
+
+    if (index == G_MAXUINT)
+    {
+        return FALSE;
+    }
+
+    if (forward)
+    {
+        if (index + 1 >= self->columns->len)
+        {
+            return FALSE;
+        }
+
+        return select_in_column (self, index + 1, 0);
+    }
+
+    if (index == 0)
+    {
+        return FALSE;
+    }
+
+    GtkTreeListRow *parent_row = nautilus_column_model_get_parent_row (get_column (self, index)->model);
+
+    return select_in_column (self, index - 1,
+                             nautilus_column_model_find_row (get_column (self, index - 1)->model,
+                                                             parent_row));
+}
+
+static gboolean
+nautilus_columns_view_grab_focus (GtkWidget *widget)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (widget);
+    guint index = find_focused_column (self);
+
+    if (self->columns->len > 0)
+    {
+        if (index == G_MAXUINT)
+        {
+            index = self->columns->len - 1;
+        }
+
+        return gtk_widget_grab_focus (get_column (self, index)->list_view);
+    }
+
+    return GTK_WIDGET_CLASS (nautilus_columns_view_parent_class)->grab_focus (widget);
+}
+
+static void
+on_hadjustment_changed (GtkAdjustment       *adjustment,
+                        NautilusColumnsView *self)
+{
+    if (!self->scroll_to_end)
+    {
+        return;
+    }
+
+    self->scroll_to_end = FALSE;
+    gtk_adjustment_set_value (adjustment,
+                              gtk_adjustment_get_upper (adjustment) -
+                              gtk_adjustment_get_page_size (adjustment));
+}
+
+static void
+nautilus_columns_view_dispose (GObject *object)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (object);
+    NautilusViewModel *model = nautilus_list_base_get_model (NAUTILUS_LIST_BASE (self));
+
+    /* Skip collapsing and unloading: NautilusFilesView tears it all down. */
+    self->updating_columns = TRUE;
+
+    if (model != NULL &&
+        nautilus_view_model_get_sorter (model) == self->view_model_sorter)
+    {
+        nautilus_view_model_set_sorter (model, NULL);
+    }
+    g_clear_object (&self->view_model_sorter);
+
+    g_clear_handle_id (&self->prune_columns_id, g_source_remove);
+
+    g_ptr_array_set_size (self->columns, 0);
+
+    G_OBJECT_CLASS (nautilus_columns_view_parent_class)->dispose (object);
+}
+
+static void
+nautilus_columns_view_finalize (GObject *object)
+{
+    NautilusColumnsView *self = NAUTILUS_COLUMNS_VIEW (object);
+
+    g_clear_pointer (&self->columns, g_ptr_array_unref);
+
+    G_OBJECT_CLASS (nautilus_columns_view_parent_class)->finalize (object);
+}
+
+static void
+nautilus_columns_view_class_init (NautilusColumnsViewClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+    GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+    NautilusListBaseClass *list_base_class = NAUTILUS_LIST_BASE_CLASS (klass);
+
+    object_class->dispose = nautilus_columns_view_dispose;
+    object_class->finalize = nautilus_columns_view_finalize;
+
+    widget_class->grab_focus = nautilus_columns_view_grab_focus;
+
+    list_base_class->get_backing_item = real_get_backing_item;
+    list_base_class->get_icon_size = real_get_icon_size;
+    list_base_class->get_sort_state = real_get_sort_state;
+    list_base_class->get_view_info = real_get_view_info;
+    list_base_class->get_zoom_level = real_get_zoom_level;
+    list_base_class->scroll_to = real_scroll_to;
+    list_base_class->set_enable_rubberband = real_set_enable_rubberband;
+    list_base_class->set_sort_state = real_set_sort_state;
+    list_base_class->set_zoom_level = real_set_zoom_level;
+    list_base_class->setup_directory = real_setup_directory;
+
+    signals[LOAD_SUBDIRECTORY] = g_signal_new ("load-subdirectory",
+                                               G_TYPE_FROM_CLASS (klass),
+                                               G_SIGNAL_RUN_LAST,
+                                               0, NULL, NULL,
+                                               g_cclosure_marshal_VOID__OBJECT,
+                                               G_TYPE_NONE,
+                                               1, NAUTILUS_TYPE_VIEW_ITEM);
+    signals[UNLOAD_SUBDIRECTORY] = g_signal_new ("unload-subdirectory",
+                                                 G_TYPE_FROM_CLASS (klass),
+                                                 G_SIGNAL_RUN_LAST,
+                                                 0, NULL, NULL,
+                                                 g_cclosure_marshal_VOID__OBJECT,
+                                                 G_TYPE_NONE,
+                                                 1, NAUTILUS_TYPE_VIEW_ITEM);
+    signals[DISPLAY_LOCATION_CHANGED] = g_signal_new ("display-location-changed",
+                                                      G_TYPE_FROM_CLASS (klass),
+                                                      G_SIGNAL_RUN_LAST,
+                                                      0, NULL, NULL,
+                                                      g_cclosure_marshal_VOID__OBJECT,
+                                                      G_TYPE_NONE,
+                                                      1, G_TYPE_FILE);
+}
+
+static void
+nautilus_columns_view_init (NautilusColumnsView *self)
+{
+    GtkWidget *scrolled_window = nautilus_list_base_get_scrolled_window (NAUTILUS_LIST_BASE (self));
+
+    gtk_widget_add_css_class (GTK_WIDGET (self), "nautilus-columns-view");
+
+    self->columns = g_ptr_array_new_with_free_func ((GDestroyNotify) column_free);
+    self->expand_as_a_tree = TRUE;
+
+    self->columns_box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+    gtk_accessible_update_property (GTK_ACCESSIBLE (self->columns_box),
+                                    GTK_ACCESSIBLE_PROPERTY_LABEL,
+                                    _("Content View"),
+                                    GTK_ACCESSIBLE_PROPERTY_ROLE_DESCRIPTION,
+                                    _("View of the current location"),
+                                    -1);
+
+    gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled_window),
+                                    GTK_POLICY_AUTOMATIC, GTK_POLICY_NEVER);
+    gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (scrolled_window), self->columns_box);
+    g_signal_connect_object (gtk_scrolled_window_get_hadjustment (GTK_SCROLLED_WINDOW (scrolled_window)),
+                             "changed", G_CALLBACK (on_hadjustment_changed), self,
+                             G_CONNECT_DEFAULT);
+
+    nautilus_list_base_setup_gestures (NAUTILUS_LIST_BASE (self));
+
+    g_signal_connect_swapped (self, "notify::model", G_CALLBACK (on_model_changed), self);
+
+    g_signal_connect_object (gtk_filechooser_preferences,
+                             "changed::" NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST,
+                             G_CALLBACK (update_sort_directories_first),
+                             self,
+                             G_CONNECT_SWAPPED);
+
+    nautilus_list_base_set_zoom_level (NAUTILUS_LIST_BASE (self), get_default_zoom_level ());
+
+    /* Capture phase, otherwise GtkListBase's cursor movement handles them. */
+    GtkEventController *controller = gtk_shortcut_controller_new ();
+    gtk_widget_add_controller (GTK_WIDGET (self), controller);
+    gtk_event_controller_set_propagation_phase (controller, GTK_PHASE_CAPTURE);
+    gtk_shortcut_controller_add_shortcut (GTK_SHORTCUT_CONTROLLER (controller),
+                                          gtk_shortcut_new (gtk_keyval_trigger_new (GDK_KEY_Left, 0),
+                                                            gtk_callback_action_new (move_between_columns_cb,
+                                                                                     GINT_TO_POINTER (GDK_KEY_Left),
+                                                                                     NULL)));
+    gtk_shortcut_controller_add_shortcut (GTK_SHORTCUT_CONTROLLER (controller),
+                                          gtk_shortcut_new (gtk_keyval_trigger_new (GDK_KEY_Right, 0),
+                                                            gtk_callback_action_new (move_between_columns_cb,
+                                                                                     GINT_TO_POINTER (GDK_KEY_Right),
+                                                                                     NULL)));
+}
+
+NautilusColumnsView *
+nautilus_columns_view_new (void)
+{
+    return g_object_new (NAUTILUS_TYPE_COLUMNS_VIEW, NULL);
+}
