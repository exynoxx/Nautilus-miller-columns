diff --git a/src/nautilus-column-model.c b/src/nautilus-column-model.c
new file mode 100644
index 000000000..8906c897d
--- /dev/null
+++ b/src/nautilus-column-model.c
@@ -0,0 +1,375 @@
+/*
+ * Copyright (C) 2026 The GNOME project contributors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "nautilus-column-model.h"
+
+#include "nautilus-view-model.h"
+
+/**
+ * NautilusColumnModel:
+ *
+ * Presents the children of one #GtkTreeListRow of a #NautilusViewModel as a
+ * #GtkSelectionModel, with all selection state kept in the shared model.
+ *
+ * A directory's rows are not contiguous once a sibling is expanded, so the
+ * slice keeps the rows plus their shared positions. gtk_tree_list_row_get_position()
+ * can't be used: it is unsorted, while #NautilusViewModel is sorted.
+ */
+
+struct _NautilusColumnModel
+{
+    GObject parent_instance;
+
+    NautilusViewModel *shared_model;
+    GtkTreeListRow *parent_row;
+
+    GPtrArray *rows;
+    GArray *positions;
+
+    GtkTreeListRow *path_row;
+};
+
+static void
+rebuild_slice (NautilusColumnModel *self)
+{
+    guint n_shared = g_list_model_get_n_items (G_LIST_MODEL (self->shared_model));
+    g_autoptr (GPtrArray) rows = g_ptr_array_new_with_free_func (g_object_unref);
+    g_autoptr (GArray) positions = g_array_new (FALSE, FALSE, sizeof (guint));
+    guint old_length = self->rows->len;
+    guint common;
+    guint prefix;
+    guint suffix;
+
+    /* ponytail: full scan per column per change; index the parents if it
+     * ever shows up in a profile. */
+    for (guint i = 0; i < n_shared; i++)
+    {
+        g_autoptr (GtkTreeListRow) row = g_list_model_get_item (G_LIST_MODEL (self->shared_model), i);
+        g_autoptr (GtkTreeListRow) parent = gtk_tree_list_row_get_parent (row);
+
+        if (parent == self->parent_row)
+        {
+            g_ptr_array_add (rows, g_steal_pointer (&row));
+            g_array_append_val (positions, i);
+        }
+    }
+
+    /* Only signal the changed middle: expanding a row shifts shared positions
+     * without changing this slice. */
+    common = MIN (old_length, rows->len);
+    for (prefix = 0; prefix < common; prefix++)
+    {
+        if (g_ptr_array_index (self->rows, prefix) != g_ptr_array_index (rows, prefix))
+        {
+            break;
+        }
+    }
+    for (suffix = 0; suffix < common - prefix; suffix++)
+    {
+        if (g_ptr_array_index (self->rows, old_length - 1 - suffix) !=
+            g_ptr_array_index (rows, rows->len - 1 - suffix))
+        {
+            break;
+        }
+    }
+
+    g_ptr_array_unref (self->rows);
+    g_array_unref (self->positions);
+    self->rows = g_steal_pointer (&rows);
+    self->positions = g_steal_pointer (&positions);
+
+    if (old_length == prefix + suffix && self->rows->len == prefix + suffix)
+    {
+        return;
+    }
+
+    g_list_model_items_changed (G_LIST_MODEL (self), prefix,
+                                old_length - prefix - suffix,
+                                self->rows->len - prefix - suffix);
+}
+
+static void
+on_shared_selection_changed (NautilusColumnModel *self)
+{
+    if (self->rows->len > 0)
+    {
+        gtk_selection_model_selection_changed (GTK_SELECTION_MODEL (self), 0, self->rows->len);
+    }
+}
+
+static GType
+nautilus_column_model_get_item_type (GListModel *list)
+{
+    return GTK_TYPE_TREE_LIST_ROW;
+}
+
+static guint
+nautilus_column_model_get_n_items (GListModel *list)
+{
+    NautilusColumnModel *self = NAUTILUS_COLUMN_MODEL (list);
+
+    return self->rows->len;
+}
+
+static gpointer
+nautilus_column_model_get_item (GListModel *list,
+                                guint       position)
+{
+    NautilusColumnModel *self = NAUTILUS_COLUMN_MODEL (list);
+
+    if (position >= self->rows->len)
+    {
+        return NULL;
+    }
+
+    return g_object_ref (g_ptr_array_index (self->rows, position));
+}
+
+static void
+nautilus_column_model_list_model_init (GListModelInterface *iface)
+{
+    iface->get_item_type = nautilus_column_model_get_item_type;
+    iface->get_n_items = nautilus_column_model_get_n_items;
+    iface->get_item = nautilus_column_model_get_item;
+}
+
+static gboolean
+nautilus_column_model_is_selected (GtkSelectionModel *model,
+                                   guint              position)
+{
+    NautilusColumnModel *self = NAUTILUS_COLUMN_MODEL (model);
+    guint global_position = nautilus_column_model_get_global_position (self, position);
+
+    return (global_position != GTK_INVALID_LIST_POSITION &&
+            gtk_selection_model_is_selected (GTK_SELECTION_MODEL (self->shared_model),
+                                             global_position));
+}
+
+static GtkBitset *
+nautilus_column_model_get_selection_in_range (GtkSelectionModel *model,
+                                              guint              position,
+                                              guint              n_items)
+{
+    NautilusColumnModel *self = NAUTILUS_COLUMN_MODEL (model);
+    GtkBitset *selection = gtk_bitset_new_empty ();
+
+    for (guint i = position; i < self->rows->len && i - position < n_items; i++)
+    {
+        if (nautilus_column_model_is_selected (model, i))
+        {
+            gtk_bitset_add (selection, i);
+        }
+    }
+
+    return selection;
+}
+
+static gboolean
+nautilus_column_model_select_item (GtkSelectionModel *model,
+                                   guint              position,
+                                   gboolean           unselect_rest)
+{
+    NautilusColumnModel *self = NAUTILUS_COLUMN_MODEL (model);
+    guint global_position = nautilus_column_model_get_global_position (self, position);
+
+    if (global_position == GTK_INVALID_LIST_POSITION)
+    {
+        return FALSE;
+    }
+
+    return gtk_selection_model_select_item (GTK_SELECTION_MODEL (self->shared_model),
+                                            global_position, unselect_rest);
+}
+
+static gboolean
+nautilus_column_model_unselect_item (GtkSelectionModel *model,
+                                     guint              position)
+{
+    NautilusColumnModel *self = NAUTILUS_COLUMN_MODEL (model);
+    guint global_position = nautilus_column_model_get_global_position (self, position);
+
+    if (global_position == GTK_INVALID_LIST_POSITION)
+    {
+        return FALSE;
+    }
+
+    return gtk_selection_model_unselect_item (GTK_SELECTION_MODEL (self->shared_model),
+                                              global_position);
+}
+
+static gboolean
+nautilus_column_model_set_selection (GtkSelectionModel *model,
+                                     GtkBitset         *selected,
+                                     GtkBitset         *mask)
+{
+    NautilusColumnModel *self = NAUTILUS_COLUMN_MODEL (model);
+    g_autoptr (GtkBitset) global_selected = gtk_bitset_new_empty ();
+    g_autoptr (GtkBitset) global_mask = gtk_bitset_new_empty ();
+    GtkBitsetIter iter;
+    guint i;
+
+    /* A full-column mask means "replace the selection", which must also clear
+     * the other columns. */
+    if (self->rows->len > 0 &&
+        gtk_bitset_get_size_in_range (mask, 0, self->rows->len - 1) == self->rows->len)
+    {
+        gtk_bitset_add_range (global_mask, 0,
+                              g_list_model_get_n_items (G_LIST_MODEL (self->shared_model)));
+    }
+
+    if (gtk_bitset_iter_init_first (&iter, mask, &i))
+    {
+        do
+        {
+            guint global_position = nautilus_column_model_get_global_position (self, i);
+
+            if (global_position != GTK_INVALID_LIST_POSITION)
+            {
+                gtk_bitset_add (global_mask, global_position);
+                if (gtk_bitset_contains (selected, i))
+                {
+                    gtk_bitset_add (global_selected, global_position);
+                }
+            }
+        }
+        while (gtk_bitset_iter_next (&iter, &i));
+    }
+
+    return gtk_selection_model_set_selection (GTK_SELECTION_MODEL (self->shared_model),
+                                              global_selected, global_mask);
+}
+
+static void
+nautilus_column_model_selection_model_init (GtkSelectionModelInterface *iface)
+{
+    iface->is_selected = nautilus_column_model_is_selected;
+    iface->get_selection_in_range = nautilus_column_model_get_selection_in_range;
+    iface->select_item = nautilus_column_model_select_item;
+    iface->set_selection = nautilus_column_model_set_selection;
+    iface->unselect_item = nautilus_column_model_unselect_item;
+}
+
+G_DEFINE_FINAL_TYPE_WITH_CODE (NautilusColumnModel, nautilus_column_model, G_TYPE_OBJECT,
+                               G_IMPLEMENT_INTERFACE (G_TYPE_LIST_MODEL,
+                                                      nautilus_column_model_list_model_init)
+                               G_IMPLEMENT_INTERFACE (GTK_TYPE_SELECTION_MODEL,
+                                                      nautilus_column_model_selection_model_init))
+
+static void
+nautilus_column_model_dispose (GObject *object)
+{
+    NautilusColumnModel *self = NAUTILUS_COLUMN_MODEL (object);
+
+    if (self->shared_model != NULL)
+    {
+        g_signal_handlers_disconnect_by_data (self->shared_model, self);
+        g_clear_object (&self->shared_model);
+    }
+
+    g_clear_object (&self->parent_row);
+    g_clear_object (&self->path_row);
+
+    G_OBJECT_CLASS (nautilus_column_model_parent_class)->dispose (object);
+}
+
+static void
+nautilus_column_model_finalize (GObject *object)
+{
+    NautilusColumnModel *self = NAUTILUS_COLUMN_MODEL (object);
+
+    g_ptr_array_unref (self->rows);
+    g_array_unref (self->positions);
+
+    G_OBJECT_CLASS (nautilus_column_model_parent_class)->finalize (object);
+}
+
+static void
+nautilus_column_model_class_init (NautilusColumnModelClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+    object_class->dispose = nautilus_column_model_dispose;
+    object_class->finalize = nautilus_column_model_finalize;
+}
+
+static void
+nautilus_column_model_init (NautilusColumnModel *self)
+{
+    self->rows = g_ptr_array_new_with_free_func (g_object_unref);
+    self->positions = g_array_new (FALSE, FALSE, sizeof (guint));
+}
+
+NautilusColumnModel *
+nautilus_column_model_new (NautilusViewModel *shared_model,
+                           GtkTreeListRow    *parent_row)
+{
+    NautilusColumnModel *self;
+
+    g_return_val_if_fail (NAUTILUS_IS_VIEW_MODEL (shared_model), NULL);
+
+    self = g_object_new (NAUTILUS_TYPE_COLUMN_MODEL, NULL);
+    self->shared_model = g_object_ref (shared_model);
+    g_set_object (&self->parent_row, parent_row);
+
+    g_signal_connect_swapped (shared_model, "items-changed",
+                              G_CALLBACK (rebuild_slice), self);
+    g_signal_connect_swapped (shared_model, "selection-changed",
+                              G_CALLBACK (on_shared_selection_changed), self);
+
+    rebuild_slice (self);
+
+    return self;
+}
+
+GtkTreeListRow *
+nautilus_column_model_get_parent_row (NautilusColumnModel *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_COLUMN_MODEL (self), NULL);
+
+    return self->parent_row;
+}
+
+guint
+nautilus_column_model_get_global_position (NautilusColumnModel *self,
+                                           guint                position)
+{
+    g_return_val_if_fail (NAUTILUS_IS_COLUMN_MODEL (self), GTK_INVALID_LIST_POSITION);
+
+    if (position >= self->rows->len)
+    {
+        return GTK_INVALID_LIST_POSITION;
+    }
+
+    return g_array_index (self->positions, guint, position);
+}
+
+guint
+nautilus_column_model_find_row (NautilusColumnModel *self,
+                                GtkTreeListRow      *row)
+{
+    guint position;
+
+    g_return_val_if_fail (NAUTILUS_IS_COLUMN_MODEL (self), GTK_INVALID_LIST_POSITION);
+
+    return g_ptr_array_find (self->rows, row, &position) ? position : GTK_INVALID_LIST_POSITION;
+}
+
+GtkTreeListRow *
+nautilus_column_model_get_path_row (NautilusColumnModel *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_COLUMN_MODEL (self), NULL);
+
+    return self->path_row;
+}
+
+void
+nautilus_column_model_set_path_row (NautilusColumnModel *self,
+                                    GtkTreeListRow      *row)
+{
+    g_return_if_fail (NAUTILUS_IS_COLUMN_MODEL (self));
+
+    g_set_object (&self->path_row, row);
+}
