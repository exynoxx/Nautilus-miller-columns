+
+#include "test-utilities.h"
+
+#include "nautilus-column-model.h"
+#include "nautilus-file.h"
+#include "nautilus-file-utilities.h"
+#include "nautilus-view-item.h"
+#include "nautilus-view-model.h"
+
+/* dir_a is expanded in every test, so the root rows are not contiguous. */
+static const char *hierarchy[] =
+{
+    "dir_a/",
+    "dir_a/child_1",
+    "dir_a/child_2",
+    "dir_b/",
+    "file_c",
+    NULL
+};
+
+typedef struct
+{
+    NautilusViewModel *model;
+} Fixture;
+
+static NautilusViewItem *
+new_item_for (const char *relative_path)
+{
+    g_autofree char *path = g_build_filename (test_get_tmp_dir (), relative_path, NULL);
+    g_autofree char *uri = g_filename_to_uri (path, NULL, NULL);
+    g_autoptr (NautilusFile) file = nautilus_file_get_by_uri (uri);
+
+    /* NautilusViewModel needs the info to tell whether a row is expandable. */
+    file_load_attributes (file, NAUTILUS_ATTRIBUTE_INFO);
+
+    return nautilus_view_item_new (file);
+}
+
+static void
+add_items (NautilusViewModel *model,
+           const char        *first_path,
+           ...)
+{
+    g_autolist (NautilusViewItem) items = NULL;
+    va_list args;
+
+    va_start (args, first_path);
+    for (const char *path = first_path; path != NULL; path = va_arg (args, const char *))
+    {
+        items = g_list_append (items, new_item_for (path));
+    }
+    va_end (args);
+
+    nautilus_view_model_add_items (model, items);
+}
+
+static GtkTreeListRow *
+get_row (NautilusViewModel *model,
+         guint              position)
+{
+    return g_list_model_get_item (G_LIST_MODEL (model), position);
+}
+
+static void
+fixture_set_up (Fixture       *fixture,
+                gconstpointer  data)
+{
+    file_hierarchy_create ((GStrv) hierarchy, "");
+
+    fixture->model = nautilus_view_model_new (FALSE);
+    add_items (fixture->model, "dir_a", "dir_b", "file_c", NULL);
+
+    /* Creates dir_a's child store. */
+    g_autoptr (GtkTreeListRow) row_a = get_row (fixture->model, 0);
+    g_assert_true (gtk_tree_list_row_is_expandable (row_a));
+    gtk_tree_list_row_set_expanded (row_a, TRUE);
+
+    add_items (fixture->model, "dir_a/child_1", "dir_a/child_2", NULL);
+
+    /* dir_a, child_1, child_2, dir_b, file_c */
+    g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (fixture->model)), ==, 5);
+}
+
+static void
+fixture_tear_down (Fixture       *fixture,
+                   gconstpointer  data)
+{
+    g_clear_object (&fixture->model);
+    test_clear_tmp_dir ();
+}
+
+/* The root column holds the root rows only, and skips the expanded subtree. */
+static void
+test_root_slice_skips_children (Fixture       *fixture,
+                                gconstpointer  data)
+{
+    g_autoptr (NautilusColumnModel) root = nautilus_column_model_new (fixture->model, NULL);
+
+    g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (root)), ==, 3);
+    g_assert_cmpuint (nautilus_column_model_get_global_position (root, 0), ==, 0);
+    g_assert_cmpuint (nautilus_column_model_get_global_position (root, 1), ==, 3);
+    g_assert_cmpuint (nautilus_column_model_get_global_position (root, 2), ==, 4);
+    g_assert_cmpuint (nautilus_column_model_get_global_position (root, 3), ==,
+                      GTK_INVALID_LIST_POSITION);
+}
+
+/* The child column holds exactly the children of its parent row. */
+static void
+test_child_slice (Fixture       *fixture,
+                  gconstpointer  data)
+{
+    g_autoptr (GtkTreeListRow) row_a = get_row (fixture->model, 0);
+    g_autoptr (NautilusColumnModel) child = nautilus_column_model_new (fixture->model, row_a);
+
+    g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (child)), ==, 2);
+    g_assert_cmpuint (nautilus_column_model_get_global_position (child, 0), ==, 1);
+    g_assert_cmpuint (nautilus_column_model_get_global_position (child, 1), ==, 2);
+
+    g_assert_true (nautilus_column_model_get_parent_row (child) == row_a);
+}
+
+/* Selecting in a column selects in the shared model, at the global position. */
+static void
+test_selection_is_translated (Fixture       *fixture,
+                              gconstpointer  data)
+{
+    g_autoptr (GtkTreeListRow) row_a = get_row (fixture->model, 0);
+    g_autoptr (NautilusColumnModel) root = nautilus_column_model_new (fixture->model, NULL);
+    g_autoptr (NautilusColumnModel) child = nautilus_column_model_new (fixture->model, row_a);
+
+    /* Second child of dir_a: local 1 in the child column, global 2. */
+    g_assert_true (gtk_selection_model_select_item (GTK_SELECTION_MODEL (child), 1, TRUE));
+    g_assert_true (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (fixture->model), 2));
+    g_assert_true (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (child), 1));
+    g_assert_false (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (child), 0));
+
+    /* And the other way round: file_c is global 4, local 2 in the root column. */
+    g_assert_true (gtk_selection_model_select_item (GTK_SELECTION_MODEL (fixture->model), 4, TRUE));
+    g_assert_true (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (root), 2));
+    g_assert_false (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (child), 1));
+
+    g_autoptr (GtkBitset) selection = gtk_selection_model_get_selection (GTK_SELECTION_MODEL (root));
+    g_assert_cmpuint (gtk_bitset_get_size (selection), ==, 1);
+    g_assert_true (gtk_bitset_contains (selection, 2));
+}
+
+/* The path row is a highlight, not part of the selection. */
+static void
+test_path_row_is_not_selection (Fixture       *fixture,
+                                gconstpointer  data)
+{
+    g_autoptr (GtkTreeListRow) row_a = get_row (fixture->model, 0);
+    g_autoptr (NautilusColumnModel) root = nautilus_column_model_new (fixture->model, NULL);
+
+    nautilus_column_model_set_path_row (root, row_a);
+    g_assert_true (nautilus_column_model_get_path_row (root) == row_a);
+
+    g_assert_false (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (root), 0));
+    g_assert_false (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (fixture->model), 0));
+
+    g_autoptr (GtkBitset) selection = gtk_selection_model_get_selection (GTK_SELECTION_MODEL (root));
+    g_assert_cmpuint (gtk_bitset_get_size (selection), ==, 0);
+
+    nautilus_column_model_set_path_row (root, NULL);
+    g_assert_null (nautilus_column_model_get_path_row (root));
+}
+
+/* Replacing the selection in one column clears the others. */
+static void
+test_selection_replaces_across_columns (Fixture       *fixture,
+                                        gconstpointer  data)
+{
+    g_autoptr (GtkTreeListRow) row_a = get_row (fixture->model, 0);
+    g_autoptr (NautilusColumnModel) root = nautilus_column_model_new (fixture->model, NULL);
+    g_autoptr (NautilusColumnModel) child = nautilus_column_model_new (fixture->model, row_a);
+
+    /* dir_a, global 0, selected in the root column. */
+    gtk_selection_model_select_item (GTK_SELECTION_MODEL (root), 0, TRUE);
+    g_assert_true (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (fixture->model), 0));
+
+    /* Select every row of the child column, the way a rubberband drag does. */
+    gtk_selection_model_select_all (GTK_SELECTION_MODEL (child));
+
+    g_assert_false (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (fixture->model), 0));
+    g_assert_true (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (fixture->model), 1));
+    g_assert_true (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (fixture->model), 2));
+}
+
+/* Collapsing the parent row empties the child column instead of crashing. */
+static void
+test_child_slice_after_collapse (Fixture       *fixture,
+                                 gconstpointer  data)
+{
+    g_autoptr (GtkTreeListRow) row_a = get_row (fixture->model, 0);
+    g_autoptr (NautilusColumnModel) root = nautilus_column_model_new (fixture->model, NULL);
+    g_autoptr (NautilusColumnModel) child = nautilus_column_model_new (fixture->model, row_a);
+
+    gtk_tree_list_row_set_expanded (row_a, FALSE);
+
+    g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (child)), ==, 0);
+    g_assert_cmpuint (nautilus_column_model_find_row (child, row_a), ==,
+                      GTK_INVALID_LIST_POSITION);
+
+    /* The root rows are contiguous again. */
+    g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (root)), ==, 3);
+    g_assert_cmpuint (nautilus_column_model_get_global_position (root, 1), ==, 1);
+    g_assert_cmpuint (nautilus_column_model_get_global_position (root, 2), ==, 2);
+    g_assert_cmpuint (nautilus_column_model_find_row (root, row_a), ==, 0);
+}
+
+static gint
+sort_by_name_descending (gconstpointer a,
+                         gconstpointer b,
+                         gpointer      user_data)
+{
+    return g_strcmp0 (nautilus_file_get_name (nautilus_view_item_get_file ((NautilusViewItem *) b)),
+                      nautilus_file_get_name (nautilus_view_item_get_file ((NautilusViewItem *) a)));
+}
+
+/* Positions follow the shared model's sorted order, not the tree model's. */
+static void
+test_positions_follow_sort_order (Fixture       *fixture,
+                                  gconstpointer  data)
+{
+    g_autoptr (GtkTreeListRow) row_a = get_row (fixture->model, 0);
+    g_autoptr (GtkCustomSorter) sorter = gtk_custom_sorter_new (sort_by_name_descending, NULL, NULL);
+
+    nautilus_view_model_set_sorter (fixture->model, GTK_SORTER (sorter));
+
+    /* Sorted: file_c, dir_b, dir_a, [dir_a's children] child_2, child_1 */
+    g_autoptr (NautilusColumnModel) root = nautilus_column_model_new (fixture->model, NULL);
+    g_autoptr (NautilusColumnModel) child = nautilus_column_model_new (fixture->model, row_a);
+
+    g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (root)), ==, 3);
+    g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (child)), ==, 2);
+
+    for (guint i = 0; i < 3; i++)
+    {
+        g_autoptr (GtkTreeListRow) expected = get_row (fixture->model, i);
+
+        g_assert_cmpuint (nautilus_column_model_get_global_position (root, i), ==, i);
+        g_assert_true (nautilus_column_model_find_row (root, expected) == i);
+    }
+
+    g_assert_cmpuint (nautilus_column_model_get_global_position (child, 0), ==, 3);
+    g_assert_cmpuint (nautilus_column_model_get_global_position (child, 1), ==, 4);
+
+    g_assert_true (gtk_selection_model_select_item (GTK_SELECTION_MODEL (child), 0, TRUE));
+    g_autoptr (GtkTreeListRow) selected_row = get_row (fixture->model, 3);
+    g_autoptr (NautilusViewItem) selected = gtk_tree_list_row_get_item (selected_row);
+    g_assert_cmpstr (nautilus_file_get_name (nautilus_view_item_get_file (selected)), ==, "child_2");
+    g_assert_true (gtk_selection_model_is_selected (GTK_SELECTION_MODEL (fixture->model), 3));
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    g_test_init (&argc, &argv, NULL);
+    g_test_set_nonfatal_assertions ();
+    nautilus_ensure_extension_points ();
+
+    g_test_add ("/column-model/root-slice-skips-children", Fixture, NULL,
+                fixture_set_up, test_root_slice_skips_children, fixture_tear_down);
+    g_test_add ("/column-model/child-slice", Fixture, NULL,
+                fixture_set_up, test_child_slice, fixture_tear_down);
+    g_test_add ("/column-model/selection-is-translated", Fixture, NULL,
+                fixture_set_up, test_selection_is_translated, fixture_tear_down);
+    g_test_add ("/column-model/path-row-is-not-selection", Fixture, NULL,
+                fixture_set_up, test_path_row_is_not_selection, fixture_tear_down);
+    g_test_add ("/column-model/selection-replaces-across-columns", Fixture, NULL,
+                fixture_set_up, test_selection_replaces_across_columns, fixture_tear_down);
+    g_test_add ("/column-model/child-slice-after-collapse", Fixture, NULL,
+                fixture_set_up, test_child_slice_after_collapse, fixture_tear_down);
+    g_test_add ("/column-model/positions-follow-sort-order", Fixture, NULL,
+                fixture_set_up, test_positions_follow_sort_order, fixture_tear_down);
+
+    return g_test_run ();
+}
